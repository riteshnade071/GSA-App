# Copy these into Render -> Environment (never commit real values to GitHub).
# Placeholders only.

# --- Database / login tokens (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
JWT_SECRET=put-a-long-random-string-here-at-least-32-characters

# --- Email delivery through Brevo (required) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-v3-api-key
EMAIL_FROM=no-reply@your-verified-domain.example
EMAIL_FROM_NAME=OpportunityHub

# --- OR: send from your own Gmail through the Gmail API (HTTPS, works on Render free) ---
# EMAIL_PROVIDER=gmail_api
# EMAIL_FROM=yourname@gmail.com
# GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token
# (EMAIL_PROVIDER=gmail = SMTP + GMAIL_APP_PASSWORD; Render's free plan blocks SMTP, so use it only on a paid/other host)

# --- Continue with Google (no OTP email needed) ---
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Optional limits (defaults shown) ---
OTP_IP_LIMIT=30
VERIFY_IP_LIMIT=100
LOGIN_FAIL_LIMIT=8

# --- Optional: tells the server it is production even outside Render ---
# (On Render this is detected automatically through the RENDER variable.)
# APP_ENV=production

# NEVER set any of these in production (the server refuses to start if they are present):
# OTP_DEV_ECHO, OTP_BYPASS, OTP_TEST_MODE, SKIP_OTP, DISABLE_OTP, OTP_REQUIRED=false, BREVO_API_BASE
