# Copy these into Render -> Environment (never commit real values to GitHub).
# Placeholders only.

# --- Database / login tokens (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
JWT_SECRET=put-a-long-random-string-here-at-least-32-characters

# --- Email delivery through Brevo (required) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-v3-api-key
EMAIL_FROM=no-reply@your-verified-domain.example
EMAIL_FROM_NAME=OpportunityHub

# --- Optional limits (defaults shown) ---
OTP_IP_LIMIT=10
VERIFY_IP_LIMIT=40
LOGIN_FAIL_LIMIT=8

# --- Optional: tells the server it is production even outside Render ---
# (On Render this is detected automatically through the RENDER variable.)
# APP_ENV=production

# NEVER set any of these in production (the server refuses to start if they are present):
# OTP_DEV_ECHO, OTP_BYPASS, OTP_TEST_MODE, SKIP_OTP, DISABLE_OTP, OTP_REQUIRED=false, BREVO_API_BASE
